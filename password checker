import string

def check_password_strength(password):
    score = 0

    # 1. Length check
    if len(password) >= 8:
        score += 1
    # 2. Uppercase letter check
    if any(char in string.ascii_uppercase for char in password):
        score += 1
    # 3. Lowercase letter check
    if any(char in string.ascii_lowercase for char in password):
        score += 1
    # 4. Digit check
    if any(char in string.digits for char in password):
        score += 1
    # 5. Symbol check
    if any(char in string.punctuation for char in password):
        score += 1
    # Strength decision
    if score <= 2:
        return "Weak"
    elif score == 3 or score == 4:
        return "Medium"
    else:
        return "Strong"
